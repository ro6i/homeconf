# This is the configuration file for Ghostty.

keybind = cmd+v=paste_from_clipboard

background = #000000
foreground = #ff8600
font-family = m817
# font-family = Menlo
font-size = 17
font-synthetic-style = italic,no-bold,no-bold-italic

# background-opacity = 0.5
# background-opacity-cells = true

# cursor-style = block
# cursor-style-blink = false

# cursor-color = #a050e0
cursor-color = #78a800
cursor-text  = #000000

adjust-underline-position = -3
# adjust-underline-thickness = 4
adjust-cursor-thickness = 5

mouse-hide-while-typing = true

