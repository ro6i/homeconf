palette = 9=#ff5e4d
palette = 10=#bbcd13
palette = 11=#ffc105
palette = 12=#ff85cc
palette = 13=#ffa59e
palette = 14=#77b054
palette = 15=#e3b7a0
palette = 16=#13100c
palette = 17=#340d04
palette = 18=#191a09
palette = 19=#25170e
palette = 20=#221028
palette = 21=#290f1a
palette = 22=#0c1311
palette = 23=#2e241f
palette = 24=#40312b
palette = 25=#db4d00
palette = 26=#a3990f
palette = 27=#d69a00
palette = 28=#c775c7
palette = 29=#dd6499
palette = 30=#8f8b42
palette = 31=#9f7c60

custom-shader = ~/.config/ghostty/ghostty-shaders/custom-bloom-inward.2.glsl
custom-shader = ~/.config/ghostty/ghostty-shaders/custom-cursor.glsl

async-backend = epoll

custom-shader-animation = false

shell-integration-features = no-cursor
app-notifications = no-clipboard-copy,config-reload
