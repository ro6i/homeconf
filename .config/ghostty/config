# This is the configuration file for Ghostty.

keybind = cmd+v=paste_from_clipboard

background = #000000
foreground = #f59f00
font-family = m1015
# font-family = Hack
font-size = 15
font-synthetic-style = italic,no-bold,no-bold-italic

# background-opacity = 0.5
# background-opacity-cells = true

# cursor-style = block
# cursor-style-blink = false

# cursor-color = #a050e0
cursor-color = #374d00
cursor-text  = #ffffff

adjust-underline-position = -3
adjust-underline-thickness = -1
adjust-cursor-thickness = 5

mouse-hide-while-typing = true

palette = 0=#000050
palette = 1=#ff5833
palette = 2=#c0a611
palette = 3=#eba800
palette = 4=#ea7bbc
palette = 5=#f881a1
palette = 6=#a8a34d
