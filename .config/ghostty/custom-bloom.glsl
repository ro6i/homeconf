const vec3 LUMINANCE_COEFFICIENTS = vec3(0.2126, 0.7152, 0.0722);

bool isColorBright(vec3 color, float threshold) {
    float luminance = dot(color, LUMINANCE_COEFFICIENTS);
    return luminance > threshold;
}

float lum(vec4 c) {
  return 0.299 * c.r + 0.587 * c.g + 0.144 * c.b;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
  vec2 uv = fragCoord.xy / iResolution.xy;

  vec4 color = texture(iChannel0, uv);

  if (!isColorBright(color.rgb, 0.15)) {
    vec2 step1 = vec2(1.1, 1.05) / iResolution.xy;

    for (int i = 0; i < 24; i++) {
      vec3 s = samples[i] * 1;
      vec4 c = texture(iChannel0, uv + s.xy * step1);
      float l = lum(c);
      if (l > 0.001) {
        color += l * s.z * c * 0.10;
        // color += l * 0.5 * c * 0.05;
      }
    }
  }

  fragColor = color;
}
